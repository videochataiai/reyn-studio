{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "reyn-yc-access",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "reynflow.com/api/yc-access/*",
      "zone_name": "reynflow.com"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "AUTH_EVENTS",
      "id": "87d5c9588dd742ed835f9740f0219509"
    }
  ],
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "2026073001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "vars": {
    "TERMS_VERSION": "1.0",
    "PRIVACY_VERSION": "1.0",
    "SESSION_TTL_SECONDS": "86400",
    "EVENT_RETENTION_SECONDS": "2592000"
  },
  "secrets": {
    "required": [
      "YC_USERNAME",
      "YC_PASSWORD_DIGEST_HEX",
      "AUTH_PEPPER",
      "EVENT_HASH_KEY"
    ]
  },
  "observability": {
    "enabled": false,
    "logs": {
      "enabled": false,
      "invocation_logs": false,
      "persist": false
    },
    "traces": {
      "enabled": false,
      "persist": false
    }
  }
}
